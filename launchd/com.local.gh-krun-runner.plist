<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.gh-krun-runner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/gh-krun-runner/bin/gh-krun-daemon</string>
        <string>-config</string>
        <string>/Users/Shared/gh-krun-runner/config.toml</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/eek/Library/Logs/gh-krun-runner/daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/eek/Library/Logs/gh-krun-runner/daemon.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/gh-krun-runner</string>
</dict>
</plist>
